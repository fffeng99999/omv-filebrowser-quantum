#
# This file is part of OpenMediaVault.
#
# @license   https://www.gnu.org/licenses/gpl.html GPL Version 3
# @author    ${GITHUB_USER} <${GITHUB_USER}@users.noreply.github.com>
#
# OpenMediaVault is free software: you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation, either version 3 of the License, or
# any later version.
#
# Control the FileBrowser Quantum Docker container registered in the
# openmediavault-compose plugin with automatic tmpfs anti-recursion masking.
#
# Usage: omv-filebrowserquantum-ctl <cmd> [arg]
#
# The stack is owned by the Compose plugin and lives in the Compose
# plugin shared folder:
#   <compose shared folder>/filebrowserquantum/filebrowserquantum.yml
# Every stack command is executed through /usr/sbin/omv-compose-run
# (the helper of the Compose plugin), so the same --file arguments
# are used as from the Compose web UI.
#
# Every check that decides whether the container may be started, and every
# write to the upstream config.yaml, is implemented once in
# /usr/share/openmediavault/filebrowserquantum/fbq_tools.py (Python) and
# called from here, so this ctl and the test suite run the same code:
#
#   gate            fail-closed preconditions (enabled, data folder,
#                   at least one resolvable storage source, Compose folder)
#   prepare-config  declarative, atomic synchronisation of config.yaml
#   maskcheck       verify the rendered stack against the live layout
#   maskreport      print the anti-recursion protection report
#   verify          the container must be running and healthy
#
# Commands:
#   up            gate, prepare config, mask check, then start the stack
#   down          stop and remove container (data is kept)
#   restart       restart the stack after gate, prepare and mask check
#   upgrade       pull the configured image tag, prepare, mask check, up
#   status        print "running" | "stopped" | "notinstalled"
#   version       print running image tag
#   latest <ch>   print latest upstream release tag (ch = stable | beta)
#   health        print container health status
#   verify        fail unless the container runs and is healthy
#   gate          fail unless the container may be started
#   prepare       synchronise config.yaml only
#   dockerroot    print docker data-root directory
#   logs          print last 300 log lines
#   showcompose   print rendered filebrowserquantum.yml
#   path          print stack directory
#   maskcheck     verify anti-recursion invariants before up
#   maskreport    print anti-recursion protection report
#   unregister    remove stack from Compose plugin (on purge)

set -u

. /usr/share/openmediavault/scripts/helper-functions

STACK="filebrowserquantum"
CONTAINER="filebrowserquantum"
TOOLS="/usr/share/openmediavault/filebrowserquantum/fbq_tools.py"

CMD="${1:-}"
ARG="${2:-}"

case "$CMD" in
	gate|prepare|up|down|restart|upgrade|status|version|latest|health|verify|dockerroot|logs|showcompose|path|maskcheck|maskreport|unregister)
	;;
	*)
		echo "Usage: omv-filebrowserquantum-ctl <gate|prepare|up|down|restart|upgrade|status|version|latest|health|verify|dockerroot|logs|showcompose|path|maskcheck|maskreport|unregister> [arg]" >&2
		exit 64
	;;
esac

# ---------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------

# Read a scalar property from config database (jq preferred, python3 fallback)
conf_value() {
	_id="$1"
	_key="$2"
	if command -v jq >/dev/null 2>&1; then
		omv-confdbadm read "$_id" 2>/dev/null | jq -r ".${_key} // empty"
	else
		omv-confdbadm read "$_id" 2>/dev/null | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    val = data.get('${_key}', '')
    if val is not None:
        print(val)
except Exception:
    pass
" 2>/dev/null
	fi
}

ref_path() {
	omv_get_sharedfolder_path "$1" 2>/dev/null || true
}

compose_sf_path() {
	_ref="$(conf_value conf.service.compose sharedfolderref)"
	[ -n "$_ref" ] && ref_path "$_ref"
}

stack_dir() {
	_sf="$(compose_sf_path)"
	[ -n "$_sf" ] && echo "$_sf/$STACK"
}

stack_file() {
	_dir="$(stack_dir)"
	[ -n "$_dir" ] && echo "$_dir/$STACK.yml"
}

dc() {
	if [ ! -x /usr/sbin/omv-compose-run ]; then
		echo "ERROR: the openmediavault-compose plugin is not installed." >&2
		return 1
	fi
	/usr/sbin/omv-compose-run "$STACK" "$@" 2>&1
}

docker_root() {
	if command -v docker >/dev/null 2>&1; then
		docker info --format '{{.DockerRootDir}}' 2>/dev/null || echo "/var/lib/docker"
	else
		echo "/var/lib/docker"
	fi
}

tools() {
	if [ ! -f "$TOOLS" ]; then
		echo "ERROR: $TOOLS is missing. Reinstall the openmediavault-filebrowserquantum package." >&2
		return 1
	fi
	python3 "$TOOLS" "$@"
}

# Fail closed when the service may not be started.
require_gate() {
	tools gate || exit 1
}

# Declarative synchronization of config.yaml (+ ownership of the data folder).
prepare_config() {
	_ref="$(conf_value conf.service.filebrowserquantum dataRef)"
	if [ -z "$_ref" ]; then
		echo "ERROR: no data shared folder is configured." >&2
		exit 1
	fi
	_dir="$(ref_path "$_ref")"
	if [ -z "$_dir" ] || [ ! -d "$_dir" ]; then
		echo "ERROR: the configured data folder is not available. Mount the file system or fix the shared folder before starting the container." >&2
		exit 1
	fi

	_puid="$(conf_value conf.service.filebrowserquantum puid)"
	[ -n "$_puid" ] || _puid=1000
	_pgid="$(conf_value conf.service.filebrowserquantum pgid)"
	[ -n "$_pgid" ] || _pgid=100

	# Ensure the data folder and the cache directory are owned by the
	# container user, otherwise SQLite fails with "readonly database".
	chown "$_puid:$_pgid" "$_dir" 2>/dev/null || true
	chmod 775 "$_dir" 2>/dev/null || true
	if [ ! -d "$_dir/tmp" ]; then
		mkdir -p "$_dir/tmp"
	fi
	chown -R "$_puid:$_pgid" "$_dir/tmp" 2>/dev/null || true
	for _f in "$_dir/database.sqlite" "$_dir"/database.sqlite-*; do
		if [ -e "$_f" ]; then
			chown "$_puid:$_pgid" "$_f" 2>/dev/null || true
			chmod 664 "$_f" 2>/dev/null || true
		fi
	done

	# config.yaml: merged with the user's own settings, never silently
	# replaced when it cannot be parsed, written atomically with a backup.
	tools prepare-config || exit 1

	chown "$_puid:$_pgid" "$_dir/config.yaml" 2>/dev/null || true
	chmod 0664 "$_dir/config.yaml" 2>/dev/null || true
}

maskcheck() {
	_yml="$(stack_file)"
	tools maskcheck "$_yml" || exit 1
}

# ---------------------------------------------------------------------
# Command Dispatcher
# ---------------------------------------------------------------------

case "$CMD" in
	up)
		require_gate
		prepare_config
		maskcheck
		dc up -d --remove-orphans || exit 1
	;;
	down)
		dc down --remove-orphans || exit 1
	;;
	restart)
		require_gate
		prepare_config
		maskcheck
		dc restart || exit 1
	;;
	upgrade)
		require_gate
		# Pull first: a failing pull (wrong tag, network) must fail the
		# task instead of being swallowed, and must not touch the running
		# container either.
		dc pull || exit 1
		prepare_config
		maskcheck
		dc up -d --remove-orphans || exit 1
	;;
	status)
		_dir="$(stack_dir)"
		if [ -z "$_dir" ] || [ ! -f "$_dir/$STACK.yml" ]; then
			echo "notinstalled"
			exit 0
		fi
		if command -v docker >/dev/null 2>&1; then
			_state="$(docker inspect --format '{{.State.Status}}' "$CONTAINER" 2>/dev/null || true)"
			if [ "$_state" = "running" ]; then
				echo "running"
				exit 0
			fi
		fi
		echo "stopped"
	;;
	version)
		if ! command -v docker >/dev/null 2>&1; then
			exit 0
		fi
		_img="$(docker inspect --format '{{.Config.Image}}' "$CONTAINER" 2>/dev/null || true)"
		[ -n "$_img" ] || exit 0
		echo "${_img##*:}"
	;;
	latest)
		_ch="${ARG:-stable}"
		_tag=$(curl -fsS --max-time 6 \
			https://github.com/gtsteffaniak/filebrowser/releases.atom 2>/dev/null \
			| grep -o '<title[^>]*>[^<]*</title>' \
			| sed -n 's#.*<title[^>]*>\([^<]*\)</title>.*#\1#p' \
			| grep -- "-${_ch}" \
			| head -n 1)
		if [ -z "$_tag" ]; then
			_tag=$(curl -fsS --max-time 8 \
				https://api.github.com/repos/gtsteffaniak/filebrowser/releases 2>/dev/null \
				| grep -o '"tag_name": *"[^"]*"' \
				| sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' \
				| grep -- "-${_ch}" \
				| head -n 1)
		fi
		[ -n "$_tag" ] && echo "$_tag"
	;;
	health)
		if command -v docker >/dev/null 2>&1; then
			_h="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$CONTAINER" 2>/dev/null || true)"
			[ -n "$_h" ] && echo "$_h" || echo "unknown"
		else
			echo "unknown"
		fi
	;;
	verify)
		tools verify || exit 1
	;;
	gate)
		tools gate
	;;
	prepare)
		prepare_config
	;;
	dockerroot)
		docker_root
	;;
	logs)
		dc logs --tail 300
	;;
	showcompose)
		cat "$(stack_dir)/$STACK.yml" 2>/dev/null || true
	;;
	path)
		stack_dir
	;;
	maskcheck)
		maskcheck
	;;
	maskreport)
		tools maskreport "$(stack_file)"
	;;
	unregister)
		if [ ! -x /usr/sbin/omv-rpc ]; then
			echo "omv-rpc not available - skipping."
			exit 0
		fi
		_uuid="$(omv-rpc -u admin Config get '{"id":"conf.service.compose.file"}' 2>/dev/null \
			| python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    data = []
if isinstance(data, dict):
    data = data.get("data", []) or []
for obj in data:
    if isinstance(obj, dict) and obj.get("name") == "filebrowserquantum":
        print(obj.get("uuid", ""))
        break
' 2>/dev/null)"
		if [ -n "$_uuid" ]; then
			echo "Removing the FileBrowser Quantum stack from the Compose plugin ..."
			omv-rpc -u admin Compose deleteFile "{\"uuid\":\"$_uuid\"}" >/dev/null 2>&1 \
				&& echo "The stack was removed." \
				|| echo "The stack could not be removed automatically - delete it on the Compose page."
		else
			echo "No FileBrowser Quantum stack registered in the Compose plugin."
		fi
	;;
esac

exit 0
