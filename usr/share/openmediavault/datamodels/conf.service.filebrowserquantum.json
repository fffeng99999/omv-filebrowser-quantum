{
	"type": "config",
	"id": "conf.service.filebrowserquantum",
	"title": "FileBrowser Quantum",
	"queryinfo": {
		"xpath": ".//services/filebrowserquantum",
		"iterable": false
	},
	"properties": {
		"enable": {
			"type": "boolean",
			"default": false
		},
		"version": {
			"type": "string",
			"default": "2.0.10-beta"
		},
		"port": {
			"type": "integer",
			"minimum": 1,
			"maximum": 65535,
			"default": 8085
		},
		"imageVariant": {
			"type": "string",
			"enum": [
				"full",
				"slim"
			],
			"default": "full"
		},
		"dataRef": {
			"type": "string",
			"oneOf": [
				{
					"type": "string",
					"format": "uuidv4"
				},
				{
					"type": "string",
					"maxLength": 0
				}
			],
			"default": ""
		},
		"sourceRef": {
			"type": "string",
			"oneOf": [
				{
					"type": "string",
					"format": "uuidv4"
				},
				{
					"type": "string",
					"maxLength": 0
				}
			],
			"default": ""
		},
		"baseURL": {
			"type": "string",
			"default": ""
		},
		"appUrl": {
			"type": "string",
			"default": ""
		},
		"trustProxyHeaders": {
			"type": "boolean",
			"default": false
		},
		"authMethod": {
			"type": "string",
			"enum": [
				"password",
				"noauth",
				"proxy"
			],
			"default": "password"
		},
		"authProxyHeader": {
			"type": "string",
			"default": "X-Forwarded-User"
		},
		"puid": {
			"type": "integer",
			"minimum": 0,
			"maximum": 65535,
			"default": 1000
		},
		"pgid": {
			"type": "integer",
			"minimum": 0,
			"maximum": 65535,
			"default": 100
		},
		"maskProtected": {
			"type": "boolean",
			"default": true
		},
		"extraOptions": {
			"type": "string",
			"default": ""
		},
		"sources": {
			"type": "object",
			"properties": {
				"source": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"uuid": {
								"type": "string",
								"format": "uuidv4"
							},
							"sharedfolderref": {
								"type": "string",
								"oneOf": [
									{
										"type": "string",
										"format": "uuidv4"
									},
									{
										"type": "string",
										"maxLength": 0
									}
								],
								"default": ""
							},
							"path": {
								"type": "string",
								"default": ""
							},
							"name": {
								"type": "string",
								"default": ""
							},
							"readonly": {
								"type": "boolean",
								"default": false
							},
							"defaultEnabled": {
								"type": "boolean",
								"default": true
							}
						}
					}
				}
			}
		}
	}
}
