{
	"type": "config",
	"id": "conf.service.filebrowserquantum",
	"title": "FileBrowser Quantum",
	"queryinfo": {
		"xpath": ".//services/filebrowserquantum",
		"iterable": false
	},
	"properties": {
		"enable": {
			"type": "boolean",
			"default": false
		},
		"version": {
			"type": "string",
			"default": "2.0.10-beta"
		},
		"port": {
			"type": "integer",
			"minimum": 1,
			"maximum": 65535,
			"default": 8085
		},
		"imageVariant": {
			"type": "string",
			"enum": [
				"full",
				"slim"
			],
			"default": "full"
		},
		"dataRef": {
			"type": "string",
			"oneOf": [{
				"type": "string",
				"format": "uuidv4"
			}, {
				"type": "string",
				"maxLength": 0
			}],
			"default": ""
		},
		"sourceRef": {
			"type": "string",
			"oneOf": [{
				"type": "string",
				"format": "uuidv4"
			}, {
				"type": "string",
				"maxLength": 0
			}],
			"default": ""
		}
	}
}
