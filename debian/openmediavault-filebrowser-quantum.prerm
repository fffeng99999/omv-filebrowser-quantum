set -e

case "$1" in
	remove)
		# Unregister the FileBrowser Quantum container from the
		# openmediavault-compose plugin: the Compose plugin stops the
		# container and removes the generated stack files. The data and
		# source shared folders are user data and are never touched.
		# Best effort only, a failure must not block the removal.
		/usr/sbin/omv-filebrowserquantum-ctl unregister || true
	;;

	upgrade|failed-upgrade|abort-install|abort-upgrade|disappear|purge)
		# The stack is kept as is; an upgrade must not interrupt it.
	;;

	*)
		echo "prerm called with unknown argument '$1'" >&2
		exit 1
	;;
esac

exit 0
